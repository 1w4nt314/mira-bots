{
  "name": "mira-bots",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "dev:hook": "cargo build -p mira-hook -p mira-mcp",
    "build:hook": "cargo build --release -p mira-hook -p mira-mcp",
    "copy:hook": "node scripts/copy-hook.mjs",
    "check:mac": "CC_aarch64_apple_darwin=\"$PWD/scripts/mac-cc.sh\" cargo check --workspace --all-targets --target aarch64-apple-darwin",
    "clippy:mac": "CC_aarch64_apple_darwin=\"$PWD/scripts/mac-cc.sh\" cargo clippy --workspace --all-targets --target aarch64-apple-darwin -- -D warnings",
    "test:node": "node scripts/test-terminal-input.mjs && node scripts/test-bot-core.mjs && node scripts/test-markdown.mjs && node scripts/test-models.mjs && node scripts/test-tickets.mjs && node scripts/test-office.mjs && node scripts/test-projects.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "~6.3.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@xterm/addon-fit": "~0.11.0",
    "@xterm/xterm": "~6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
